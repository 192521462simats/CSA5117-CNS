#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[] = "MONARCHY";
    char matrix[5][5];
    char alpha[] = "ABCDEFGHIKLMNOPQRSTUVWXYZ";
    int used[26] = {0};
    int i, j, k = 0, r1, c1, r2, c2;

    printf("Enter ciphertext: ");
    scanf("%s", text);

    for (i = 0; key[i]; i++)
    {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';

        if (!used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for (i = 0; alpha[i]; i++)
        if (!used[alpha[i] - 'A'])
        {
            matrix[k / 5][k % 5] = alpha[i];
            used[alpha[i] - 'A'] = 1;
            k++;
        }

    printf("Decrypted text: ");

    for (i = 0; text[i] && text[i + 1]; i += 2)
    {
        char x = toupper(text[i]);
        char y = toupper(text[i + 1]);

        if (x == 'J') x = 'I';
        if (y == 'J') y = 'I';

        for (j = 0; j < 25; j++)
        {
            if (matrix[j / 5][j % 5] == x)
                r1 = j / 5, c1 = j % 5;
            if (matrix[j / 5][j % 5] == y)
                r2 = j / 5, c2 = j % 5;
        }

        if (r1 == r2)
            printf("%c%c", matrix[r1][(c1 + 4) % 5],
                   matrix[r2][(c2 + 4) % 5]);
        else if (c1 == c2)
            printf("%c%c", matrix[(r1 + 4) % 5][c1],
                   matrix[(r2 + 4) % 5][c2]);
        else
            printf("%c%c", matrix[r1][c2], matrix[r2][c1]);
    }

    return 0;
}