#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while (b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    char text[100];
    int a, b, i;

    printf("Enter plaintext: ");
    scanf("%s", text);

    printf("Enter a and b: ");
    scanf("%d %d", &a, &b);

    if (gcd(a, 26) != 1)
    {
        printf("Invalid a! Choose a coprime with 26.");
        return 0;
    }

    printf("Encrypted text: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = toupper(text[i]);

        if (ch >= 'A' && ch <= 'Z')
            printf("%c", ((a * (ch - 'A') + b) % 26) + 'A');
        else
            printf("%c", ch);
    }

    return 0;
}