#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[30] = "MONARCHY";
    char matrix[5][5];
    int i, j, k = 0, a, b;
    char ch;

    printf("Enter plaintext: ");
    scanf("%s", text);

    for (i = 0; key[i]; i++)
    {
        key[i] = toupper(key[i]);
        if (key[i] == 'J')
            key[i] = 'I';
    }

    char alpha[] = "ABCDEFGHIKLMNOPQRSTUVWXYZ";
    char used[26] = {0};

    for (i = 0; key[i]; i++)
        if (!used[key[i] - 'A'])
        {
            matrix[k / 5][k % 5] = key[i];
            used[key[i] - 'A'] = 1;
            k++;
        }

    for (i = 0; alpha[i]; i++)
        if (!used[alpha[i] - 'A'])
        {
            matrix[k / 5][k % 5] = alpha[i];
            used[alpha[i] - 'A'] = 1;
            k++;
        }

    for (i = 0; text[i]; i++)
        text[i] = toupper(text[i]);

    printf("Encrypted text: ");

    for (i = 0; text[i]; i += 2)
    {
        char x = text[i];
        char y = text[i + 1] ? text[i + 1] : 'X';
        int r1, c1, r2, c2;

        if (x == 'J') x = 'I';
        if (y == 'J') y = 'I';

        if (x == y)
            y = 'X';

        for (a = 0; a < 5; a++)
            for (b = 0; b < 5; b++)
            {
                if (matrix[a][b] == x)
                    r1 = a, c1 = b;
                if (matrix[a][b] == y)
                    r2 = a, c2 = b;
            }

        if (r1 == r2)
            printf("%c%c", matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        else if (c1 == c2)
            printf("%c%c", matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        else
            printf("%c%c", matrix[r1][c2], matrix[r2][c1]);
    }

    return 0;
}