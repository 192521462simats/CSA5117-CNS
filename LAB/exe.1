#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int i, k;

    printf("Enter a message: ");
    scanf("%s", text);

    printf("Enter key (1-25): ");
    scanf("%d", &k);

    for (i = 0; text[i] != '\0'; i++)
    {
        if (text[i] >= 'A' && text[i] <= 'Z')
            text[i] = (text[i] - 'A' + k) % 26 + 'A';
        else if (text[i] >= 'a' && text[i] <= 'z')
            text[i] = (text[i] - 'a' + k) % 26 + 'a';
    }

    printf("Encrypted message: %s\n", text);

    return 0;
}