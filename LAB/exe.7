#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100];
    char key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i;

    printf("Enter ciphertext: ");
    scanf("%s", text);

    printf("Plaintext: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = toupper(text[i]);

        for (int j = 0; j < 26; j++)
        {
            if (ch == key[j])
            {
                printf("%c", 'A' + j);
                break;
            }
        }
    }

    return 0;
}